      <rules key="{01be9d1b-843e-4600-a340-5c392855650a}">
        <rule description="Igneous material with more than 63 percent SiO2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/acidicIgneousMaterial'" key="{43149110-22a1-433b-b343-e3403198ab53}" label="acidic igneous material" symbol="0"></rule>
        <rule description="Igneous rock with more than 63 percent SiO2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/acidicIgneousRock'" key="{748ffd5c-424b-4428-b226-e4898a7d333c}" label="acidic igneous rock" symbol="1"></rule>
        <rule description="Granitic rock that has a plagioclase to total feldspar ratio less than 0.1. QAPF field 2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_granite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparGranite'" key="{9bb94f60-c45f-4655-9498-273c836f9ba0}" label="alkali feldspar granite" symbol="2"></rule>
        <rule description="Rhyolitoid in which the ratio of plagioclase to total feldspar is less than 0.1. QAPF field 2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_rhyolite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparRhyolite'" key="{94077532-7e55-4de1-97e0-383bc1c8040c}" label="alkali feldspar rhyolite" symbol="3"></rule>
        <rule description="Alkali feldspar syenitic rock that contains 0-5 percent quartz and no feldspathoid in the QAPF fraction. QAPF field 6." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyenite'" key="{8e314f0c-ff27-46a1-ad14-88907d8365d8}" label="alkali feldspar syenite" symbol="4"></rule>
        <rule description="Syenitoid with a plagioclase to total feldspar ratio of less than 0.1. QAPF fields 6, 6*, and 6'." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenitic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyeniticRock'" key="{347c1ebe-14f4-41e6-9e0c-0c8c8d840882}" label="alkali feldspar syenitic rock" symbol="5"></rule>
        <rule description="Trachytoid that has a plagioclase to total feldspar ratio less than 0.1, between 0 and 5 percent quartz in the QAPF fraction, and no feldspathoid minerals. QAPF field 6." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyte'" key="{4816765a-abc9-46e9-9158-8e54eeccce39}" label="alkali feldspar trachyte" symbol="6"></rule>
        <rule description="Trachytoid that has a plagioclase to total feldspar ratio less than 0.1. QAPF fields 6, 6', and 6*." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachytic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyticRock'" key="{b57a6dad-f24a-4dff-9771-a90fac3660c4}" label="alkali feldspar trachytic rock" symbol="7"></rule>
        <rule description="Alkali olivine basalt is silica-undersaturated, characterized by the absence of orthopyroxene, absence of quartz, presence of olivine, and typically contains some feldspathoid mineral, alkali feldspar or phlogopite in the groundmass. Feldspar phenocrysts typically are labradorite to andesine in composition. Augite is rich in titanium compared to augite in tholeiitic basalt. Alkali olivine basalt is relatively rich in sodium." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali_olivine_basalt' OR representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/alkali-olivine_basalt' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliOlivineBasalt'" key="{3df88d14-94d1-4a05-a192-d0466514d1dd}" label="alkali olivine basalt" symbol="8"></rule>
        <rule description="Metamorphic rock mainly consisting of green, brown or black amphibole and plagioclase (including albite), which combined form 75 percent or more of the rock, and both of which are present as major constituents. The amphibole constitutes 50 percent or more of the total mafic constituents and is present in an amount of 30 percent or more; other common minerals include quartz, clinopyroxene, garnet, epidote-group minerals, biotite, titanite and scapolite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/amphibolite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/amphibolite'" key="{a638fdeb-cefd-4317-ab3f-9d6d66b8a527}" label="amphibolite" symbol="9"></rule>
        <rule description="Fine-grained igneous rock with less than 20 percent quartz and less than 10 percent feldspathoid minerals in the QAPF fraction, in which the ratio of plagioclase to total feldspar is greater 0.65. Includes rocks defined modally in QAPF fields 9 and 10 or chemically in TAS field O2 as andesite. Basalt and andesite, which share the same QAPF fields, are distinguished chemically based on silica content, with basalt defined to contain less than 52 weight percent silica. If chemical data are not available, the color index is used to distinguish the categories, with basalt defined to contain greater than 35 percent mafic minerals by volume or greater than 40 percent mafic minerals by weight. Typically consists of plagioclase (frequently zoned from labradorite to oligoclase), pyroxene, hornblende and/or biotite. Fine grained equivalent of dioritic rock." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/andesite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/andesite'" key="{cf5b624b-503c-48ab-b8f4-42bc8573314d}" label="andesite" symbol="10"></rule>
        <rule description="Anorthositic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the QAPF fraction. QAPF field 10." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/anorthosite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/anorthosite'" key="{955af5b2-bacc-40f4-b85f-7d98ea95a068}" label="anorthosite" symbol="11"></rule>
        <rule description="Leucocratic phaneritic crystalline igneous rock consisting essentially of plagioclase, often with small amounts of pyroxene. By definition, colour index M is less than 10, and plagiclase to total feldspar ratio is greater than 0.9. Less than 20 percent quartz and less than 10 percent feldspathoid in the QAPF fraction. QAPF field 10, 10*, and 10'." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/anorthositic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/anorthositicRock'" key="{b722a46d-0114-45e2-bffa-b3f0f6557e3f}" label="anorthositic rock" symbol="12"></rule>
        <rule description="Coal that has vitrinite mean random reflectance greater than 2.0% (determined in conformance with ISO 7404-5). Less than 12-14 percent volatiles (dry, ash free), greater than 91 percent fixed carbon (dry, ash free basis). The highest rank coal; very hard, glossy, black, with semimetallic luster, semi conchoidal fracture." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/anthracite_coal' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/anthraciteCoal'" key="{81466399-e236-4bc2-8177-16f30b315f5b}" label="anthrazit" symbol="13"></rule>
        <rule description="Material known to have artificial (human-related) origin; insufficient information to classify in more detail." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicMaterial'" key="{c7d5a9e0-dd92-4239-8ae7-9c17abab2282}" label="anthropogenic material" symbol="14"></rule>
        <rule description="Unconsolidated material known to have artificial (human-related) origin." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicUnconsolidatedMaterial'" key="{49a61eeb-61ff-4170-afec-8db936ec3590}" label="anthropogenic unconsolidated material" symbol="15"></rule>
        <rule description="Rock that is too fine grained to categorize in more detail." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/aphanite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/aphanite'" key="{b415fb96-e85f-4df6-9d34-e30aa2c5d75f}" label="aphanite" symbol="16"></rule>
        <rule description="Light coloured crystalline rock, characterized by a fine grained allotriomorphic-granular (aplitic, saccharoidal or xenomorphic) texture; typically granitic composition, consisting of quartz, alkali feldspar and sodic plagioclase." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/aplite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/aplite'" key="{ed28f239-228c-4619-95df-aade6cba7768}" label="aplite" symbol="17"></rule>
        <rule description="Clastic sandstone that contains less than 10 percent matrix. Matrix is mud-size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products) of detrital or diagenetic nature." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/arenite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/arenite'" key="{901d17c1-fc81-4df2-af84-af7bf152fe06}" label="arenite" symbol="18"></rule>
        <rule description="Tephra in which less than 25 percent of fragments are greater than 64 mm in longest dimension" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli'" key="{ad200d53-496e-41f4-aeb4-7da72370d163}" label="ash and lapilli" symbol="19"></rule>
        <rule description="Tephra in which more than 25 percent of particles are greater than 64 mm in largest dimension. Includes ash breccia, bomb tephra and block tephra of Gillespie and Styles (1999)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra'" key="{3fa20207-4316-4956-adeb-39ee9fc21ac8}" label="ash breccia, bomb, or block tephra" symbol="20"></rule>
        <rule description="Pyroclastic rock in which less than 25 percent of rock by volume are more than 64 mm in longest diameter. Includes tuff, lapilli tuff, and lapillistone." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff'" key="{92c40773-5ea0-494c-b503-c981ad9f1812}" label="ash tuff, lapillistone, and lapilli tuff" symbol="21"></rule>
        <rule description="Fine-grained or porphyritic igneous rock with less than 20 percent quartz, and less than 10 percent feldspathoid minerals, in which the ratio of plagioclase to total feldspar is greater 0.65. Typically composed of calcic plagioclase and clinopyroxene; phenocrysts typically include one or more of calcic plagioclase, clinopyroxene, orthopyroxene, and olivine. Includes rocks defined modally in QAPF fields 9 and 10 or chemically in TAS field B as basalt. Basalt and andesite are distinguished chemically based on silica content, with basalt defined to contain less than 52 weight percent silica. If chemical data are not available, the color index is used to distinguish the categories, with basalt defined to contain greater than 35 percent mafic minerals by volume or greater than 40 percent mafic minerals by weight." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/basalt' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/basalt'" key="{922d11c1-c663-40b5-96d4-f3af0a5e4a4b}" label="basalt" symbol="22"></rule>
        <rule description="Tephritoid that has a plagioclase to total feldspar ratio greater than 0.9, and contains more than 10 percent normative (CIPW) olivine." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/basanite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/basanite'" key="{1c184232-814c-4fa0-89b4-2d05b51ede23}" label="basanite" symbol="23"></rule>
        <rule description="Foiditoid that contains less than 90 percent feldspathoid minerals in the QAPF fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with greater than 10 percent normative olivine." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/basanitic_foidite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/basaniticFoidite'" key="{c8758bd2-d571-4d51-8db3-7e536407d14b}" label="basanitic foidite" symbol="24"></rule>
        <rule description="Igneous material with between 45 and 52 percent SiO2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/basicIgneousMaterial'" key="{e8d26a54-c744-4155-9266-2629fd68f05e}" label="basic igneous material" symbol="25"></rule>
        <rule description="Igneous rock with between 45 and 52 percent SiO2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/basicIgneousRock'" key="{679761aa-6552-47d9-bc6e-d163806234ba}" label="basic igneous rock" symbol="26"></rule>
        <rule description="Highly aluminous material containing abundant aluminium hydroxides (gibbsite, less commonly boehmite, diaspore) and aluminium-substituted iron oxides or hydroxides and generally minor or negligible kaolin minerals; may contain up to 20 percent quartz. Commonly has a pisolitic or nodular texture, and may be cemented." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/bauxite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/bauxite'" key="{b7ecda79-9cc7-4e6d-a5b1-fcb46dbadf68}" label="bauxite" symbol="27"></rule>
        <rule description="Sediment composed of greater than 50 percent material of biogenic origin. Because the biogenic material may be skeletal remains that are not organic, all biogenic sediment is not necessarily organic-rich." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/biogenic_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSediment'" key="{6de1d241-19e6-4683-b97e-cfccb64f84cb}" label="biogenic sediment" symbol="28"></rule>
        <rule description="Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by biological processes at the depositional surface, or in particles formed by biological processes within the basin of deposition." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock'" key="{3b37c0e6-0128-4483-8248-81ae5810d104}" label="biogenic silica sedimentary rock" symbol="29"></rule>
        <rule description="Coal that has vitrinite mean random reflectance greater than 0.6% and less than 2.0% (determined in conformance with ISO 7404-5), or has a gross calorific value greater than 24 MJ/kg (determined in conformance with ISO 1928). Hard, black, organic rich sedimentary rock; contains less than 91 percent fixed carbon on a dry, mineral-matter-free basis, and greater than 13-14 percent volatiles (dry, ash free). Formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/bituminous_coal' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/bituminousCoal'" key="{d1673040-3177-4ad9-ad1d-aa7ded80898d}" label="bituminous coal" symbol="30"></rule>
        <rule description="andesitic rock that contains more than 8 percent MgO. Typically consists of phenocrysts of protoenstatite, orthopyroxene, clinopyroxene, and olivine in a glassy base full of crystallites, and exhibits textures characterisitc of rapid crystal growth." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/boninite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/boninite'" key="{ea8fd9cd-5524-4ecb-86a2-e7c06367f36b}" label="boninite" symbol="31"></rule>
        <rule description="Sediment containing greater than 30 percent boulder-size particles (greater than 256 mm in diameter)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/boulder_gravel_size_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/boulderGravelSizeSediment'" key="{f1d5b4f7-bdb8-4225-82d2-9a1a95f016db}" label="boulder gravel size sediment" symbol="32"></rule>
        <rule description="Sedimentary carbonate rock with preserved biogenic texture, whose original components were bound and encrusted together during deposition by the action of plants and animals during deposition, and remained substantially in the position of growth." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/boundstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone'" key="{3641318a-0b08-454b-9fbb-5a4466b61e32}" label="boundstone" symbol="33"></rule>
        <rule description="Coarse-grained material composed of angular broken rock fragments; the fragments typically have sharp edges and unworn corners." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/breccia' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/breccia'" key="{ab38e09d-9775-4816-af19-cfca3b73ba1e}" label="breccia" symbol="34"></rule>
        <rule description="Fault material with features such as void spaces (filled or unfilled), or unconsolidated matrix material between fragments, indicating loss of cohesion during deformation. Includes fault-related breccia and gouge." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/brecciaGougeSeries'" key="{a84aa0ef-92f1-405e-9b53-1e7087b53d14}" label="breccia-gouge series" symbol="35"></rule>
        <rule description="Carbonate sediment with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes lime-sediments." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment'" key="{cf6ce57b-8c9a-4b17-a298-0727c2811e67}" label="calcareous carbonate sediment" symbol="36"></rule>
        <rule description="Carbonate sedimentary material of unspecified consolidation state with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes lime-sediments, limestone and dolomitic limestone." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSedimentaryMaterial'" key="{fbfbc347-5a42-4989-9be8-a9b83625d113}" label="calcareous carbonate sedimentary material" symbol="37"></rule>
        <rule description="Carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes limestone and dolomitic limestone." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSedimentaryRock'" key="{4940e038-b385-4957-96d9-3722f3df6ea9}" label="calcareous carbonate sedimentary rock" symbol="38"></rule>
        <rule description="Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mud' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMud'" key="{97b6d8ec-8473-4ff7-b43f-0dbf75a6fb0a}" label="carbonate mud" symbol="39"></rule>
        <rule description="Mudstone that consists of greater than 50 percent carbonate minerals of any origin in the mud size fraction." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone'" key="{ef3e282e-2de0-4190-81ec-6d44047f311e}" label="carbonate mudstone" symbol="40"></rule>
        <rule description="ooze that consists of more than 50 percent carbonate skeletal remains" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_ooze' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateOoze'" key="{13ec3c67-816c-44f7-8e4c-110090bd7cc9}" label="carbonate ooze" symbol="41"></rule>
        <rule description="Mud size sediment that contains between 10 and 50 percent carbonate minerals in any size fraction. Carbonate origin is not specified." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mud' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMud'" key="{917b3355-3350-4afd-88b4-5ed200caf4e0}" label="carbonate rich mud" symbol="42"></rule>
        <rule description="Mudstone that contains between 10 and 50 percent carbonate minerals in the mud size fraction. Carbonate origin is not specified." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMudstone'" key="{094501d1-fa97-49c6-a325-90dc467b0586}" label="carbonate rich mudstone" symbol="43"></rule>
        <rule description="Sediment in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSediment'" key="{668b1a34-168c-4087-afee-7a782f9d89e7}" label="carbonate sediment" symbol="44"></rule>
        <rule description="Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSedimentaryMaterial'" key="{c4cdece3-8f08-494f-a28e-411bcc4f2259}" label="carbonate sedimentary material" symbol="45"></rule>
        <rule description="Sedimentary rock in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite, magnesite or dolomite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSedimentaryRock'" key="{ff0b6ff5-d5ec-4c25-bcab-c58afac9daa6}" label="carbonate sedimentary rock" symbol="46"></rule>
        <rule description="Carbonate sedimentary rock with discernible mud supported depositional texture and containing greater than 10 percent allochems, and constituent particles are of intrabasinal origin. If particles are not intrabasinal, categorization as a mudstone or wackestone should be considered." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonate_wackestone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateWackestone'" key="{7a040413-1d16-4689-99a8-a55d2834c9c6}" label="carbonate wackestone" symbol="47"></rule>
        <rule description="Igneous rock composed of more than 50 percent modal carbonate minerals." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/carbonatite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/carbonatite'" key="{a3b816e2-02e9-4794-963f-1121ea02d5ea}" label="carbonatite" symbol="48"></rule>
        <rule description="Fault-related rock that maintained primary cohesion during deformation, with matrix comprising greater than 10 percent of rock mass; matrix is fine-grained material formed through grain size reduction by fracture as opposed to crystal plastic process that operate in mylonitic rock. Includes cataclasite, protocataclasite and ultracataclasite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries'" key="{19ac3c20-d0e5-4c90-b900-f752775fd72b}" label="cataclasite series" symbol="49"></rule>
        <rule description="A generally soft, white, very fine-grained, extremely pure, porous limestone. It forms under marine conditions from the gradual accumulation of skeletal elements from minute planktonic green algae (cocoliths), associated with varying proportions of larger microscopic fragments of bivalves, foraminifera and ostracods. It is common to find flint and chert nodules embedded in chalk." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/chalk' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/chalk'" key="{a9ed38f8-0f06-4d74-839b-67dc8a02528b}" label="chalk" symbol="50"></rule>
        <rule description="Sedimentary material that consists of at least 50 percent material produced by inorganic chemical processes within the basin of deposition. Includes inorganic siliceous, carbonate, evaporite, iron-rich, and phosphatic sediment classes." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/chemical_sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/chemicalSedimentaryMaterial'" key="{da5dacbd-39af-4c0f-b406-487d16acd270}" label="chemical sedimentary material" symbol="51"></rule>
        <rule description="Metamorphic rock characterized by 50 percent or more of combined chlorite, actinolite and epidote. Category for rocks generally named greenschist or greenstone." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/chlorite_actinolite_epidote_metamorphic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/chloriteActinoliteEpidoteMetamorphicRock'" key="{ce3a36eb-9687-439e-a4a6-370508a16db2}" label="chlorite actinolite epidote metamorphic rock" symbol="52"></rule>
        <rule description="Clastic sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. If more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. If rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate'" key="{a3839977-5f01-46ae-90a2-37aad2e5e979}" label="conglomerate" symbol="53"></rule>
        <rule description="Clastic sedimentary rock consisting of less than 30 percent gravel-size (2 mm) particles and with a mud to sand ratio greater than 1." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone'" key="{0302b977-56ac-476d-89ff-2c9c4dc92664}" label="mudstone" symbol="54"></rule>
        <rule description="Clastic sedimentary rock in which less than 30 percent of particles are greater than 2 mm in diameter (gravel) and the sand to mud ratio is at least 1." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone'" key="{f43e892d-e95d-4673-980f-fda2e8d690aa}" label="sandstone" symbol="55"></rule>
        <rule description="Sediment in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment'" key="{7840142e-bff1-4e76-9313-eaaff1e4d62c}" label="clastic sediment" symbol="56"></rule>
        <rule description="Sedimentary material of unspecified consolidation state in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryMaterial'" key="{629c7d15-e59e-4139-8b08-1ed01bf95c30}" label="clastic sedimentary material" symbol="57"></rule>
        <rule description="Sedimentary rock in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock'" key="{fe1cb26d-3838-4b35-af96-f4b7603dd029}" label="clastic sedimentary rock" symbol="58"></rule>
        <rule description="Mud that consists of greater than 50 percent particles with grain size less than 0.004 mm" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/clay' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/clay'" key="{e5c034fd-edfb-4583-b296-d43a4ad64776}" label="clay" symbol="59"></rule>
        <rule description="Mudstone that contains no detectable silt, inferred to consist virtually entirely of clay-size particles." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/claystone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/claystone'" key="{0649edfe-5ec5-45d9-861a-a1f652e51b4d}" label="claystone" symbol="60"></rule>
        <rule description="A consolidated organic sedimentary material having less than 75% moisture. This category includes low, medium, and high rank coals according to International Classification of In-Seam Coal (United Nations, 1998), thus including lignite. Sapropelic coal is not distinguished in this category from humic coals. Formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/coal' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/coal'" key="{38c7b979-bebf-4a4e-8253-017e77fd624d}" label="coal" symbol="61"></rule>
        <rule description="Sediment containing greater than 30 percent cobble-size particles (64-256 mm in diameter)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/cobble_gravel_size_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/cobbleGravelSizeSediment'" key="{f75fad7c-02a1-4e46-a372-9f88cfb0df1b}" label="cobble gravel size sediment" symbol="62"></rule>
        <rule description="Material of unspecified consolidation state formed by geological modification of pre-existing materials outside the realm of igneous and sedimentary processes." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisMaterial'" key="{e8b47d01-e1cb-4997-aded-da84e84f50d2}" label="composite genesis material" symbol="63"></rule>
        <rule description="Rock formed by geological modification of pre-existing rocks outside the realm of igneous and sedimentary processes." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisRock'" key="{4addd254-26b4-4051-bcc4-8520be9d46f4}" label="composite genesis rock" symbol="64"></rule>
        <rule description="An earth material composed of an aggregation of particles of earth material, possibly including other Compound Materials." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/compound_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial'" key="{37cb96e8-0410-40c1-8eb9-88d7b7aedf1f}" label="compound material" symbol="65"></rule>
        <rule description="Carbonate rock of indeterminate mineralogy in which diagenetic processes have obliterated any original depositional texture." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/crystalline_carbonate' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/crystallineCarbonate'" key="{c916a3fa-4e9e-4977-89da-83df95f63b36}" label="crystalline carbonate" symbol="66"></rule>
        <rule description="Fine grained or porphyritic crystalline rock that contains less than 90 percent mafic minerals, between 20 and 60 percent quartz in the QAPF fraction, and has a plagioclase to total feldspar ratio greater than 0.65. Includes rocks defined modally in QAPF fields 4 and 5 or chemically in TAS Field O3. Typcially composed of quartz and sodic plagioclase with minor amounts of biotite and/or hornblende and/or pyroxene; fine-grained equivalent of granodiorite and tonalite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dacite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dacite'" key="{ad23fb2a-df1f-4b18-ad83-b12f06dd7261}" label="dacite" symbol="67"></rule>
        <rule description="Unsorted or poorly sorted, clastic sedimentary rock with a wide range of particle sizes including a muddy matrix. Biogenic materials that have such texture are excluded. Distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. If more than 10 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wacke." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/diamictite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/diamictite'" key="{88d5616f-8278-416b-8dbb-b04850165daa}" label="diamictite" symbol="68"></rule>
        <rule description="Unsorted or poorly sorted, clastic sediment with a wide range of particle sizes, including a muddy matrix. Biogenic materials that have such texture are excluded. Distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. Assignment to an other size class can be used in conjunction to indicate the dominant grain size." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/diamicton' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/diamicton'" key="{332c591c-b792-4bdf-aeba-42977c1f6b15}" label="diamicton" symbol="69"></rule>
        <rule description="Phaneritic crystalline rock consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite; colour index M less than 90, sodic plagioclase (An0-An50), no feldspathoid, and between 0 and 5 percent quartz. Includes rocks defined modally in QAPF field 10 as diorite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/diorite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/diorite'" key="{a267e109-d9a4-472b-b0ce-90563bcf5d08}" label="diorite" symbol="70"></rule>
        <rule description="Phaneritic crystalline rock with M less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. A dioritoid with a plagioclase to total feldspar ratio (in the QAPF fraction) greater than 0.9. Includes rocks defined modally in QAPF fields 10, 10' and 10*." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dioritic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dioriticRock'" key="{5193209a-d6b4-43e0-a8c3-2b35923e983b}" label="dioritic rock" symbol="71"></rule>
        <rule description="Phaneritic crystalline igneous rock with M less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. Plagioclase to total feldspar ratio is greater that 0.65, and anorthite content of plagioclase is less than 50 percent. Less than 10 percent feldspathoid mineral and less than 20 percent quartz in the QAPF fraction. Includes rocks defined modally in QAPF fields 9 and 10 (and their subdivisions)." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dioritoid' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dioritoid'" key="{e03f96c8-3037-43d0-82e7-b1f0d48052b6}" label="dioritoid" symbol="72"></rule>
        <rule description="Dark colored gabbroic (basaltic) or dioritic (andesitic) rock intermediate in grain size between basalt and gabbro and composed of plagioclase, pyroxene and opaque minerals; often with ophitic texture. Typically occurs as hypabyssal intrusions. Includes dolerite, microdiorite, diabase and microgabbro." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock'" key="{f0e7a732-32de-4c2d-aaa1-8036d895e966}" label="doleritic rock" symbol="73"></rule>
        <rule description="Carbonate sedimentary material of unspecified consolidation degree with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. Includes dolomite sediment, dolostone, lime dolostone and magnesite-stone." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticOrMagnesianSedimentaryMaterial'" key="{7cf4bb54-5fc2-432e-9c97-c2a336062e80}" label="dolomitic or magnesian sedimentary material" symbol="74"></rule>
        <rule description="Carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. Includes dolostone, lime dolostone and magnesite-stone." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticOrMagnesianSedimentaryRock'" key="{1930a9e3-15b9-41a1-8c64-cb7f3061597e}" label="dolomitic or magnesian sedimentary rock" symbol="75"></rule>
        <rule description="Carbonate sediment with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticSediment'" key="{fdae945a-73c1-459c-bd27-d34de83736cb}" label="dolomitic sediment" symbol="76"></rule>
        <rule description="Pure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/dolostone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite'" key="{976f3bc5-bbdf-420c-9dcc-5368552315fc}" label="dolomite" symbol="77"></rule>
        <rule description="Rock forming a hard crust or layer at or near the Earth's surface at the time of formation, e.g. in the upper horizons of a soil, characterized by structures indicative of pedogenic origin." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/duricrust' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/duricrust'" key="{9531114f-dba2-46e9-8f18-300aad517e1b}" label="duricrust" symbol="78"></rule>
        <rule description="Metamorphic rock composed of 75 percent or more (by volume) omphacite and garnet, both of which are present as major constituents, the amount of neither of them being higher than 75 percent (by volume); the presence of plagioclase precludes classification as an eclogite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/eclogite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/eclogite'" key="{80c01a3e-3826-43c7-bccc-2bfbb9e6587f}" label="eclogite" symbol="79"></rule>
        <rule description="Nonclastic sedimentary rock composed of at least 50 percent non-carbonate salts, including chloride, sulfate or borate minerals; formed through precipitation of mineral salts from a saline solution (non-carbonate salt rock)." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/evaporite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite'" key="{a402a0ef-d652-48bc-8c4c-e94aac79e303}" label="evaporite" symbol="80"></rule>
        <rule description="Kimberlite, lamproite, or lamprophyre. Generally are potassic, mafic or ultramafic rocks. Olivine (commonly serpentinized in kimberlite), and phlogopite are significant constituents." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock'" key="{b8852fd9-c870-430f-9940-7c82baf5cca2}" label="exotic alkaline rock" symbol="81"></rule>
        <rule description="Rock with 'exotic' mineralogical, textural or field setting characteristics; typically dark colored, with abundant phenocrysts. Criteria include: presence of greater than 10 percent melilite or leucite, or presence of kalsilite, or greater than 50 percent carbonate minerals. Includes Carbonatite, Melilitic rock, Kalsilitic rocks, Kimberlite, Lamproite, Leucitic rock and Lamprophyres." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock'" key="{b05fd37e-c863-480b-b21e-f15db685a8c0}" label="exotic composition igneous rock" symbol="82"></rule>
        <rule description="Evaporite that is not 50 percent halite or 50 percent gypsum or anhydrite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/exotic_evaporite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/exoticEvaporite'" key="{3f9f2ad8-c3cb-4c27-9d57-ff58eafca08e}" label="exotic evaporite" symbol="83"></rule>
        <rule description="Material formed as a result of brittle faulting, composed of greater than 10 percent matrix; matrix is fine-grained material caused by tectonic grainsize reduction." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/faultRelatedMaterial'" key="{8b854764-6f1c-4749-8271-895b8de6121c}" label="fault-related material" symbol="84"></rule>
        <rule description="Igneous rock in which the framework of the rock consists of crystals that are too small to determine mineralogy with the unaided eye; framework may include up to 50 percent glass. A significant percentage of the rock by volume may be phenocrysts. Includes rocks that are generally called volcanic rocks." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock'" key="{18342fde-cef9-4d78-a31f-9657e8da9bbe}" label="fine grained igneous rock" symbol="85"></rule>
        <rule description="Alkali feldspar syenitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the QAPF fraction. QAPF field 6'." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_syenite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparSyenite'" key="{91b38ec8-82c6-40e2-9545-d10dee44ec02}" label="foid bearing alkali feldspar syenite" symbol="86"></rule>
        <rule description="Alkali feldspar trachytic rock that contains no quartz and between 0 and 10 percent feldspathoid mineral in the QAPF fraction. QAPF field 6'." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_trachyte' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparTrachyte'" key="{b86318d2-0e93-4c9d-9e0c-7483634f3be8}" label="foid bearing alkali feldspar trachyte" symbol="87"></rule>
