        <rule description="Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/phosphateRichSedimentaryMaterial'" key="{7dedff10-2645-4e2b-8304-cbc6a6207b17}" label="phosphate rich sedimentary material" symbol="195"></rule>
