        <rule description="A gneiss with mineralogy and texture indicating derivation from a phaneritic igneous rock protolith. Typically consists of abundant feldspar, with quartz, and variable hornblende, biotite, and muscovite, with a relatively homogeneous character." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/orthogneiss' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/orthogneiss'" key="{46583770-b090-4cd8-b516-9f795f87a5ca}" label="orthogneiss" symbol="181"></rule>
        <rule description="Carbonate sedimentary rock with discernible grain supported depositional texture, containing greater than 10 percent grains, and constituent particles are of intrabasinal origin; intergranular spaces are filled by matrix." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/packstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/packstone'" key="{11cac1d6-785d-4c78-8f7b-56e493779d00}" label="packstone" symbol="182"></rule>
        <rule description="A gneiss with mineralogy and texture indicating derivation from a sedimentary rock protolith. Typically consists of abundant quartz, mica, or calcsilicate minerals; aluminosilicate minerals or garnet commonly present. Composition of rock tends to be more variable on a decimetric scale that in orthogneiss." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/paragneiss' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/paragneiss'" key="{1abd38a3-de6d-4b90-a27b-e92d2d6fbb45}" label="paragneiss" symbol="183"></rule>
        <rule description="Unconsolidated organic-rich sediment composed of at least 50 percent semi-carbonised plant remains; individual remains commonly seen with unaided eye; yellowish brown to brownish black; generally fibrous texture; can be plastic or friable. In its natural state it can be readily cut and has a very high moisture content, generally greater than 90 percent. Liptinite to Inertinite ratio is less than one (Economic Commission for Europe, Committee on Sustainable Energy- United Nations (ECE-UN), 1998, International Classification of in-Seam Coals: Energy 19, 41 pp.)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/peat' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/peat'" key="{b650b6e1-c3e1-4fda-acbe-3762a1c1ee92}" label="peat" symbol="184"></rule>
        <rule description="Sediment containing greater than 30 percent pebble-size particles (2.0 -64 mm in diameter)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment'" key="{9bc7b5ca-7fa1-4c33-add9-b85c29899fe7}" label="pebble gravel size sediment" symbol="185"></rule>
        <rule description="Exceptionally coarse grained crystalline rock with interlocking crystals; most grains are 1cm or more diameter; composition is generally that of granite, but the term may refer to the coarse grained facies of any type of igneous rock;usually found as irregular dikes, lenses, or veins associated with plutons or batholiths." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/pegmatite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/pegmatite'" key="{9c067941-f01d-4531-acab-aff346810342}" label="pegmatite" symbol="186"></rule>
        <rule description="Ultramafic rock consisting of more than 40 percent (by volume) olivine with pyroxene and/or amphibole and little or no feldspar. Commonly altered to serpentinite. Includes rocks defined modally in the ultramafic rock classification as dunite, harzburgite, lherzolite, wehrlite, olivinite, pyroxene peridotite, pyroxene hornblende peridotite or hornblende peridotite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/peridotite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite'" key="{3b684003-8ef5-4b5d-a704-d505d683fab2}" label="peridotite" symbol="187"></rule>
