        <rule description="Evaporite composed of at least 50 percent gypsum or anhydrite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite'" key="{7bc530c8-e5bf-48da-976a-24eadc37cd06}" label="gypsum or anhydrite" symbol="225"></rule>
        <rule description="Evaporite composed of at least 50 percent halite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/rock_salt' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/rockSalt'" key="{cc10649d-9422-4138-904d-e40b7ff094b2}" label="rock salt" symbol="226"></rule>
        <rule description="Clastic sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. More than half of the particles are of epiclastic origin." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/sand' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sand'" key="{0f9fd716-7d52-420e-b429-7e622b9fb775}" label="sand" symbol="227"></rule>
        <rule description="Sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. Composition or genesis of clasts not specified." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/sand_size_sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sandSizeSediment'" key="{fd95fe5a-b883-4efb-ac57-da480fa34bd8}" label="sand size sediment" symbol="228"></rule>
        <rule description="Jelly like organic rich sediment composed of plant remains, usually algal. Liptinite to Inertinite ratio is greater than one (Economic Commission for Europe, Committee on Sustainable Energy- United Nations (ECE-UN), 1998, International Classification of in-Seam Coals: Energy 19, 41 pp.)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/sapropel' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sapropel'" key="{03255ee3-a617-4e20-9b6b-af436e092256}" label="sapropel" symbol="229"></rule>
        <rule description="Foliated phaneritic metamorphic rock with well developed, continuous schistosity, meaning that greater than 50 percent of the rock by volume is mineral grains with a thin tabular, lamellar, or acicular prismatic crystallographic habit that are oriented in a continuous planar or linear fabric." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/schist' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/schist'" key="{5b292e7e-7db3-4795-9b2a-500a7102baea}" label="schist" symbol="230"></rule>
        <rule description="Unconsolidated material consisting of an aggregation of particles transported or deposited by air, water or ice, or that accumulated by other natural agents, such as chemical precipitation, and that forms in layers on the Earth's surface." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/sediment' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sediment'" key="{5d12da88-2d9c-45ee-9c6e-e8a0be2b007e}" label="sediment" symbol="231"></rule>
        <rule description="Material formed by accumulation of solid fragmental material deposited by air, water or ice, or material that accumulated by other natural agents such as chemical precipitation from solution or secretion by organisms." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial'" key="{aa534d73-26e4-47b5-862f-969320a3c278}" label="sedimentary material" symbol="232"></rule>
        <rule description="Rock formed by accumulation and cementation of solid fragmental material deposited by air, water or ice, or as a result of other natural agents, such as precipitation from solution, the accumulation of organicMaterial, or from biogenic processes, including secretion by organisms." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryRock'" key="{2ec6fbae-b707-40d1-aeae-509bcd84496e}" label="sedimentary rock" symbol="233"></rule>
        <rule description="Rock consisting of more than 75 percent serpentine-group minerals, eg. antigorite, chrysotile or lizardite; accessory chlorite, talc and magnetite may be present; derived from hydration of ferromagnesian silicate minerals such as olivine and pyroxene." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/serpentinite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/serpentinite'" key="{045ca3ca-102b-4b1b-87ab-e9a31b932a5c}" label="serpentinite" symbol="234"></rule>
        <rule description="Laminated mudstone that will part or break along thin, closely spaced layers parallel to stratification." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/shale' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/shale'" key="{9cdd521a-cee0-48d8-8363-2c24597ec015}" label="shale" symbol="235"></rule>
        <rule description="Mud size sediment that consists of less than 50 percent carbonate minerals." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/silicate_mud' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/silicateMud'" key="{7115025c-bb34-4478-80d6-e2a93ff2d023}" label="silicate mud" symbol="236"></rule>
        <rule description="Mudstone that contains less than 10 percent carbonate minerals." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/silicate_mudstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/silicateMudstone'" key="{24ef5172-16f7-40e8-97f1-2c2855ff5e1f}" label="silicate mudstone" symbol="237"></rule>
        <rule description="ooze that consists of more than 50 percent siliceous skeletal remains" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze'" key="{a30c4efa-848f-4559-88d0-7f51f3053554}" label="siliceous ooze" symbol="238"></rule>
        <rule description="Mud that consists of greater than 50 percent silt-size grains." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/silt' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/silt'" key="{6fa39439-3312-4849-b51d-5ed7ed672168}" label="silt" symbol="239"></rule>
        <rule description="Mudstone that contains detectable silt. (see comments)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/siltstone' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/siltstone'" key="{c7a95b36-a630-478f-a130-743e83643f4b}" label="siltstone" symbol="240"></rule>
        <rule description="Metasomatic rock consisting mainly of Ca-, Mg-, Fe-, or Mn-silicate minerals, which are free from or poor in water. Typically formed at the contact between a silicate rock or magma and a carbonate rock." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/skarn' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/skarn'" key="{25961e55-c924-4bff-ad88-792c25e7b21f}" label="skarn" symbol="241"></rule>
        <rule description="Compact, fine grained rock with an average grain size less than 0.032 millimeter and a well developed schistosity (slaty cleavage), and hence can be split into slabs or thin plates." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/slate' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/slate'" key="{8705cd27-a95a-4b16-afcf-d0bb099baaea}" label="slate" symbol="242"></rule>
        <rule description="Altered basic to intermediate composition fine-grained igneous rock in which the feldspar is partially or completely composed of of albite, typically accompanied by chlorite, calcite, quartz, epidote, prehnite, and low-tempaerature hydrous crystallization products. Preservation of eruptive volcanic features is typical." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/spilite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/spilite'" key="{b8573130-5b19-4408-af29-b3fc967824be}" label="spilite" symbol="243"></rule>
        <rule description="Syenitic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the QAPF fraction. Defined modally in QAPF Field 7." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/syenite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/syenite'" key="{5c13ac5d-5b99-4b4c-abb3-165a20a7d848}" label="syenite" symbol="244"></rule>
        <rule description="Syenitoid with a plagioclase to total feldspar ratio between 0.1 and 0.35. Includes rocks in QAPF fields 7, 7*, and 7'." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/syenitic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/syeniticRock'" key="{8561bba4-c9de-4b81-b518-748df0d4740e}" label="syenitic rock" symbol="245"></rule>
        <rule description="Phaneritic crystalline igneous rock with M less than 90, consisting mainly of alkali feldspar and plagioclase; minor quartz or nepheline may be present, along with pyroxene, amphibole or biotite. Ratio of plagioclase to total feldspar is less than 0.65, quartz forms less than 20 percent of QAPF fraction, and feldspathoid minerals form less than 10 percent of QAPF fraction. Includes rocks classified in QAPF fields 6, 7 and 8 and their subdivisions." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/syenitoid' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/syenitoid'" key="{dd0d8959-2ecb-4cd7-84a5-40b2a76819c9}" label="syenitoid" symbol="246"></rule>
        <rule description="Granite that has a plagiolcase to total feldspar ratio between 0.10 and 0.35. QAPF field 3a." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/syenogranite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/syenogranite'" key="{adf33ee9-7102-4815-8bad-9f0fe6ca590a}" label="syenogranite" symbol="247"></rule>
        <rule description="Unconsolidated pyroclastic material in which greater than 75 percent of the fragments are deposited as a direct result of volcanic processes and the deposit has not been reworked by epiclastic processes. Includes ash, lapilli tephra, bomb tephra, block tephra and unconsolidated agglomerate." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tephra' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tephra'" key="{6153ff67-3f7b-4613-add2-4d95925923ea}" label="tephra" symbol="248"></rule>
        <rule description="Tephritoid that has a plagioclase to total feldspar ratio greater than 0.9, and contains less than 10 percent normative (CIPW) olivine." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tephrite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tephrite'" key="{fd1cc089-9439-4634-909e-eea28d3267d1}" label="tephrite" symbol="249"></rule>
        <rule description="Foiditoid that contains less than 90 percent feldspathoid minerals in the QAPF fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with less than 10 percent normative olivine" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tephritic_foidite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tephriticFoidite'" key="{e5fd952e-6bf9-43c9-bdfc-32bb9ad7473d}" label="tephritic foidite" symbol="250"></rule>
        <rule description="Phonolitoid that has a plagioclase to total feldspar ratio between 0.1 and 0.5. Broadly corresponds to TAS tephriphonolite of TAS field U3." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tephritic_phonolite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tephriticPhonolite'" key="{7ddf4164-252d-4d5a-a051-ee1b48d6db5a}" label="tephritic phonolite" symbol="251"></rule>
        <rule description="Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the QAPF fraction and has a plagioclase to total feldspar ratio greater than 0.5. Includes rocks classified in QAPF field 13 and 14 or chemically in TAS field U1 as basanite or tephrite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tephritoid' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tephritoid'" key="{d97a4b3a-1f98-4c21-bbd1-d2a2a54cecd3}" label="tephritoid" symbol="252"></rule>
        <rule description="Tholeiitic basalt is defined here to contain 2 pyroxene phases and interstitial quartz or tridymite or cristobalite in the groundmass. Pyroxene (augite and orthopyroxene or pigeonite) and calcium-rich plagioclase are common phenocryst minerals. Olivine may also be a phenocryst, and when present, may have rims of pigeonite. Only in tholeiitic basalt is olivine in reaction relationship with melt. Interstitial siliceous residue may be present, and is often glassy. Tholeiitic basalt is relatively poor in sodium. This category includes most basalts of the ocean floor, most large oceanic islands, and continental flood basalts such as the Columbia River Plateau." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt'" key="{fa8ccdb7-9675-4b9d-88df-b554e9cba20f}" label="tholeiitic basalt" symbol="253"></rule>
        <rule description="Granitoid consisting of quartz and intermediate plagioclase, usually with biotite and amphibole. Includes rocks defined modally in QAPF field 5; ratio of plagioclase to total feldspar is greater than 0.9." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tonalite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tonalite'" key="{3b1df679-7f2f-4556-b847-1774fa500161}" label="tonalite" symbol="254"></rule>
        <rule description="Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35, between 0 and 5 percent quartz in the QAPF fraction, and no feldspathoid minerals. QAPF field 7." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/trachyte' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/trachyte'" key="{5cd93f01-2cba-4c71-bc27-de6a774cba1f}" label="trachyte" symbol="255"></rule>
        <rule description="Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35. QAPF fields 7, 7', and 7*." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/trachytic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/trachyticRock'" key="{a1fb1d4e-6646-4a92-811a-06de084a3b19}" label="trachytic rock" symbol="256"></rule>
        <rule description="Fine grained igneous rock than contains less than 90 percent mafic minerals, less than 10 percent feldspathoid mineral and less than 20 percent quartz in the QAPF fraction and has a plagioclase to total feldspar ratio less than 0.65. Mafic minerals typically include amphibole or mica; typically porphyritic. Includes rocks defined modally in QAPF fields 6, 7 and 8 (with subdivisions) or chemically in TAS Field T as trachyte or latite." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/trachytoid' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid'" key="{bb8796c6-84be-4bf4-9adf-c78f10601622}" label="trachytoid" symbol="257"></rule>
        <rule description="Biotically or abiotically precipitated calcium carbonate, from spring-fed, heated, or ambient-temperature water. May be white and spongy, various shades of orange, tan or gray, and ranges to dense, banded or laminated rock. Macrophytes, bryophytes, algae, cyanobacteria and other organisms often colonize the surface of travertine and may be preserved, to produce the porous varieties." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/travertine' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/travertine'" key="{a37d0535-33ae-4dd2-b646-e9796912f854}" label="travertine" symbol="258"></rule>
        <rule description="Pyroclastic rock in which greater than 25 percent of particles are greater than 64 mm in largest dimension. Includes agglomerate, pyroclastic breccia of Gillespie and Styles (1999)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tuff_breccia_agglomerate_or_pyroclastic_breccia' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tuffBrecciaAgglomerateOrPyroclasticBreccia'" key="{dfd0697c-9011-4897-a3f7-c0c8be71a4c4}" label="tuff-breccia, agglomerate, or pyroclastic breccia" symbol="259"></rule>
        <rule description="Rock consists of more than 50 percent particles of indeterminate pyroclastic or epiclastic origin and less than 75 percent particles of clearly pyroclastic origin." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/tuffite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/tuffite'" key="{ab3818ef-53aa-43ce-90bb-d4bb47ec126f}" label="tuffite" symbol="260"></rule>
        <rule description="Igneous rock with less than 45 percent SiO2." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/ultrabasicIgneousRock'" key="{9eff0d2f-3ab0-4688-81de-91d8101937dd}" label="ultrabasic igneous rock" symbol="261"></rule>
        <rule description="Igneous rock that consists of greater than 90 percent mafic minerals." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/ultramafic_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/ultramaficIgneousRock'" key="{3011d55d-0f61-4728-8e8a-2452184325f6}" label="ultramafic igneous rock" symbol="262"></rule>
        <rule description="CompoundMaterial composed of an aggregation of particles that do not adhere to each other strongly enough that the aggregate can be considered a solid in its own right." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/unconsolidated_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/unconsolidatedMaterial'" key="{8fff470b-3c7d-4004-8dd6-7e26206c0183}" label="unconsolidated material" symbol="263"></rule>
        <rule description="Clastic sandstone with more than 10 percent matrix of indeterminate detrital or diagenetic nature. Matrix is mud size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products)." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/wacke' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/wacke'" key="{6649b9e4-4dfb-4da7-bac4-ab2a558d4f9f}" label="wacke" symbol="264"></rule>
        <rule description="Consolidated material known to have artificial (human-related) origin." filter="representativeLithology_uri = '' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicConsolidatedMaterial'" key="{442d16f5-1ae9-4955-98af-6b927dc4889b}" label="anthropogenic consolidated material" symbol="265"></rule>
        <rule description="A composite material composed primarily of bitumen and mineral aggregates, e.g. gravel" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen'" key="{af8f8c36-ccba-46e6-ae8b-de226c89a8ce}" label="bitumen" symbol="266"></rule>
        <rule description="Material of various size originating from broken down buildings or former road coatings" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/buildingRubble'" key="{706db96b-a9e4-4139-a882-b9d79cf6b07e}" label="building rubble" symbol="267"></rule>
        <rule description="Hardening composite construction material composed primarily of coarse gravel, cement and water" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/concrete'" key="{3f99e9c7-90fa-484f-bb4d-a75da57fd54e}" label="concrete" symbol="268"></rule>
        <rule description="spoil, overburden and other material excavated in mining" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/mineDumpMaterial'" key="{7e402ae2-8fa6-4464-8f80-568a2951d051}" label="mine dump material" symbol="269"></rule>
        <rule description="more or less liquid (when disposed) by-products of wastewater treatment" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sewageSludge'" key="{5a584c57-84e3-4941-b8a1-39cb9dcb0b39}" label="sewage sludge" symbol="270"></rule>
        <rule description="by-product of smelting ore and processing metals" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/slag'" key="{de827bf1-29d6-4cbc-afd3-be9c6df0a818}" label="slag" symbol="271"></rule>
        <rule description="More or less liquid (when disposed) by-products of industrial processes" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/sludge'" key="{e8cd7183-2e72-4ef4-a2a9-39bfefb6bf8f}" label="sludge" symbol="272"></rule>
        <rule description="Material added to soil to improve plant growth and health" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/soilImprover'" key="{855e1bc6-6b67-4034-befd-76393b58d6e0}" label="soil improver" symbol="273"></rule>
        <rule description="The dark-colored upper portion af a soil, varying in depth according to soil type." filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/topsoil'" key="{6bd32e25-c859-40a7-9360-73eeaf3cc2cc}" label="topsoil" symbol="274"></rule>
        <rule description="Disposed, non-liquid by-products of any kind, e.g. domestic or industrial waste" filter="representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/waste'" key="{dfe2518e-40f3-4067-9e38-a75a58da359e}" label="waste" symbol="275"></rule>
