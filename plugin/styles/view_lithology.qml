        <rule description="Igneous rock that consists of greater than 80 percent massive glass." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock'" key="{97fe3282-752d-44a3-a219-5bc65ed71e6e}" label="glassy igneous rock" symbol="120"></rule>
