        <rule description="Metamorphic rock in which 10 percent or more of the contained mineral grains are elements in a planar or linear fabric. Cataclastic or glassy character precludes classification with this concept." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/foliatedMetamorphicRock'" key="{211ca1d4-7d77-4ebc-83c0-3270664c2d4f}" label="foliated metamorphic rock" symbol="109"></rule>
        <rule description="Igneous material of unspecified consolidation state in which greater than 75 percent of the rock consists of fragments produced as a result of igneous rock-forming process." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_material' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousMaterial'" key="{c56707f1-d4ad-4051-a878-3d77784bf4bf}" label="fragmental igneous material" symbol="110"></rule>
        <rule description="Igneous rock in which greater than 75 percent of the rock consists of fragments produced as a result of igneous rock-forming process. Includes pyroclastic rocks, autobreccia associated with lava flows and intrusive breccias. Excludes deposits reworked by epiclastic processes (see Tuffite)" filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock'" key="{58768efd-295c-4e51-9f19-868fc04e2c00}" label="fragmental igneous rock" symbol="111"></rule>
