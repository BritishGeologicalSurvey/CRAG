        <rule description="Foiditoid that contains greater than 90 percent feldspathoid minerals in the QAPF fraction." filter="representativeLithology_uri = 'http://resource.geosciml.org/classifier/cgi/lithology/foidite' OR representativeLithology_uri = 'http://inspire.ec.europa.eu/codelist/LithologyValue/foidite'" key="{b2bc12ac-ead1-491a-ad91-a4e58322aee3}" label="foidite" symbol="106"></rule>
